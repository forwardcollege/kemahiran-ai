# Public canonical URL used for metadata. Do not include a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase authentication and user-owned data. Both values are safe to expose
# to the browser; never place the secret/service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
